{
  "permissions": {
    "deny": [
      "Read(**/appsettings.Development.json)",
      "Read(**/appsettings.*.Development.json)",
      "Read(**/secrets.json)",
      "Read(**/local.settings.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.ai/generated/**)",
      "Edit(.ai/system/generated/**)"
    ],
    "allow": [
      "Bash(python tools/claude-kit/docgen.py:*)",
      "Bash(python tools/claude-kit/kit_check.py:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)"
    ]
  }
}
